projeto_prod:
  target: dev
  outputs:
    dev:
      type: bigquery
      method: service-account
      project: "{{GCP_DEV_PROJECT_ID}}"
      dataset: "{{DBT_DEV_SCHEMA}}"
      threads: 4
      keyfile: "{{GCP_DEV_KEY_FILE_PATH}}"
    prod:
      type: bigquery
      method: service-account
      project: "{{GCP_PROD_PROJECT_ID}}"
      dataset: "{{DBT_PROD_SCHEMA}}"
      threads: 4
      keyfile: "{{GCP_PROD_KEY_FILE_PATH}}"